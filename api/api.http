### ============================================
### Health Check
### ============================================

GET {{host}}/
Accept: application/json

###

### ============================================
### Create User
### ============================================

POST {{host}}/api/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "John Doe",
    "email": "jxohn@example.com",
    "password": "password123"
}

###

### ============================================
### Get All Users
### ============================================

GET {{host}}/api/users
Accept: application/json

###

### ============================================
### Login
### ============================================

POST {{host}}/api/auth/login
Content-Type: application/json

{
    "email": "pkstring",
    "password": "pppppstring"
}

###

### ============================================
### Create Product (Requires Authentication)
### ============================================

POST {{host}}/api/products/user/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "iPhe 16",
    "price": 999
}

###

### ============================================
### Get All Products
### ============================================

GET {{host}}/api/products
Accept: application/json

###

### ============================================
### Get Products By User
### ============================================

GET {{host}}/api/products/user/1
Accept: application/json

###

### ============================================
### Update Product (Requires Authentication)
### ============================================

PUT {{host}}/api/products/1
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
    "name": "iPhone 16 Pro",
    "price": 129999
}

###

### ============================================
### Delete Product (Requires Authentication)
### ============================================

DELETE {{host}}/api/products/1
Authorization: Bearer YOUR_JWT_TOKEN

###

### ============================================
### Upload Product Image
### ============================================

POST {{host}}/api/product-images/product/1
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="sample.jpg"
Content-Type: image/jpeg

< ./sample.jpg
--WebAppBoundary--

###

### ============================================
### Get Product Images
### ============================================

GET {{host}}/api/product-images/product/1
Accept: application/json

###

### ============================================
### Delete Product Image
### ============================================

DELETE {{host}}/api/product-images/1

###

### ============================================
### Truncate Database
### ============================================

DELETE {{host}}/api/admin/truncate
Authorization: Bearer YOUR_JWT_TOKEN

###